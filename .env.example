# ---------------------------------------------------------------------------
# Facade Worker (wrangler secrets / .dev.vars)
# ---------------------------------------------------------------------------
SIGNER_GATEWAY_URL="http://127.0.0.1:8788"
SIGNER_GATEWAY_TOKEN="change-me"
SCRAPEBADGER_API_KEY=""
SCRAPECREATORS_API_KEY=""
# Optional base-URL overrides, used by scripts/smoke.mjs to run fully offline.
SCRAPEBADGER_BASE_URL=""
CREATIVE_CENTER_BASE_URL=""
DAILY_PAID_BUDGET_USD="3"
# USD charged per paid-provider call (ScrapeBadger ~5 credits/call).
SCRAPEBADGER_USD_PER_CALL="0.001"
# Optional bearer token required on /mcp from remote clients.
MCP_AUTH_TOKEN=""
# Required for /admin/* (budget, cohort, breaker resets). Admin routes fail
# closed: with this unset, every admin request is rejected.
ADMIN_TOKEN="change-me"
# Shared secret the VPS posting worker uses on /admin/job-callback. Keep this,
# POSTING_WORKER_TOKEN below, and the VPS FACADE_CALLBACK_TOKEN identical.
FACADE_CALLBACK_TOKEN="change-me"
# Telegram operator alerts: posting halt, breaker trip, stale session.
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""
# Hard ceiling on a single provider attempt (ms). A hung backend is treated as
# a failure: it trips the breaker and cascades to the next provider.
PROVIDER_TIMEOUT_MS="15000"
# The public handle whose videos tt_own_* tools read.
OWN_ACCOUNT_HANDLE="nobodynamed"
# Facade -> VPS posting worker (queue dispatch + AMBER scheduled work).
POSTING_WORKER_URL="http://127.0.0.1:8799"
POSTING_WORKER_TOKEN="change-me"

# ---------------------------------------------------------------------------
# Signer gateway (VPS)
# ---------------------------------------------------------------------------
PORT="8788"
SIGNER_TOKEN="change-me"
# MOCK=1 serves deterministic fixtures instead of driving Chromium. Use it for
# local development and CI; never in production.
MOCK="0"
SIGNER_HEADLESS="1"
SIGNER_PAGE_POOL_SIZE="2"

# ---------------------------------------------------------------------------
# Playwright / posting worker (VPS)
# ---------------------------------------------------------------------------
POSTING_SESSION_AGE_KEY=""
POSTING_SESSION_FILE="./sessions/nobodynamed.json.age"
# age decryption, so key material never lives in this repo:
POSTING_SESSION_AGE_CMD="age -d -i /etc/ventriloquist/posting.key"
BURNER_COOKIES_DIR="./sessions/burners"
BURNER_SESSION_FILE="./sessions/burner.json.age"
BURNER_USER_DATA_DIR="./sessions/burner-profile"
FACADE_CALLBACK_TOKEN="change-me"
FACADE_URL=""
POSTING_HANDLE="nobodynamed"
POSTING_DRY_RUN="0"
POSTING_STATE_FILE="./sessions/job-state.json"
POSTING_SESSION_MAX_AGE_DAYS="30"
POSTING_TZ_OFFSET_MINUTES="-420"
CHROME_EXECUTABLE_PATH="/usr/bin/chromium"
# R2 S3 credentials: the VPS uploads rendered artifacts and downloads queued
# ones. Without these, only pre-seeded R2 paths work.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ventriloquist-media"
R2_PUBLIC_BASE=""
RENDER_COMMAND="uv run nbn render --story {story} --out {out}"
NBN_REPO_DIR="/home/kato/nobodynamed-video"
